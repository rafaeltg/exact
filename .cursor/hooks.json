{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "make complexity-pre",
        "matcher": "Write|StrReplace",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "scripts/hooks/post-edit.sh",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "make complexity-post",
        "matcher": "TabWrite",
        "timeout": 15
      }
    ]
  }
}
