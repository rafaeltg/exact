{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/complexity-guard.py --pre",
        "matcher": "Write|StrReplace",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/ruff-after-edit.py",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/complexity-guard.py",
        "matcher": "TabWrite",
        "timeout": 15
      }
    ]
  }
}
