{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/ruff-after-edit.py",
        "timeout": 20
      },
      {
        "command": "python3 .cursor/hooks/complexity-guard.py",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/complexity-guard.py",
        "matcher": "Write|StrReplace|TabWrite",
        "timeout": 15
      }
    ]
  }
}
