# Keys
EXA_API_KEY=
# Reserved for the dormant Elicit client. No live code reads it.
ELICIT_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cost-optimal Anthropic profile (Haiku everywhere, thinking off).
# Research is the volume hotspot; do not put Sonnet on research/router/compress.
EXACT_MODEL=anthropic:claude-haiku-4-5
EXACT_MODEL_ROUTER=anthropic:claude-haiku-4-5
EXACT_MODEL_RESEARCH=anthropic:claude-haiku-4-5
EXACT_MODEL_COMPRESS=anthropic:claude-haiku-4-5
EXACT_MODEL_WRITE=anthropic:claude-haiku-4-5

# Sampling — deterministic, capped output, no paid thinking tokens.
EXACT_TEMPERATURE=0
EXACT_MAX_TOKENS_ROUTER=1024
EXACT_MAX_TOKENS_RESEARCH=1024
EXACT_MAX_TOKENS_COMPRESS=2048
EXACT_MAX_TOKENS_WRITE=8192
EXACT_REASONING_EFFORT=none
EXACT_THINKING_BUDGET=0

# Research depth: normal | max. --effort overrides it.
EXACT_EFFORT=normal

EXACT_DB=exact.sqlite
